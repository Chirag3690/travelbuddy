{
  "name": "frontend",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan -c",
    "start:android": "expo start --android --lan -c",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "eas:login": "npx eas-cli login",
    "eas:configure": "npx eas-cli build:configure",
    "build:preview:ios": "npx eas-cli build --platform ios --profile preview",
    "build:preview:android": "npx eas-cli build --platform android --profile preview",
    "build:prod:ios": "npx eas-cli build --platform ios --profile production",
    "build:prod:android": "npx eas-cli build --platform android --profile production",
    "build:prod:all": "npx eas-cli build --platform all --profile production",
    "submit:ios": "npx eas-cli submit --platform ios --profile production --latest",
    "submit:android": "npx eas-cli submit --platform android --profile production --latest"
  },
  "dependencies": {
    "@babel/runtime": "^7.20.6",
    "@expo/dom-webview": "~58.0.2",
    "@expo/log-box": "^58.0.15",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "expo": "^58.0.0",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
